---
/**
 * HighlightedMoments.astro
 * Galería de momentos destacados del círculo de estudios.
 *
 * Arquitectura de datos: la lógica compleja se resuelve en el frontmatter
 * para evitar el bug de esbuild con operadores de comparación (<, <=)
 * dentro del template JSX de Astro.
 */
import { getMomentosDestacados, formatDateBySize } from '../lib/contentful';

const allMomentos = await getMomentosDestacados();

// Ordenar de más reciente a más antiguo
const sortedMomentos = [...allMomentos].sort(
  (a, b) => new Date(b.fecha).getTime() - new Date(a.fecha).getTime()
);

const MAX_DISPLAY = 4;
const displayMomentos = sortedMomentos.slice(0, MAX_DISPLAY);
const hasMoreMomentos = sortedMomentos.length > MAX_DISPLAY;
const totalMomentos = sortedMomentos.length;

/**
 * Configuración del layout Bento por posición.
 * Separada al frontmatter para evitar que el compilador de Astro/esbuild
 * interprete los operadores de comparación como etiquetas HTML.
 */
type BentoConfig = { basis: string; height: string };

function getBentoConfig(index: number): BentoConfig {
  const configs: Record<number, BentoConfig> = {
    0: { basis: 'flex-[1_1_60%]', height: 'h-[320px] lg:h-[380px]' },
    1: { basis: 'flex-[1_1_35%]', height: 'h-[320px] lg:h-[380px]' },
    2: { basis: 'flex-[1_1_35%]', height: 'h-[320px] lg:h-[380px]' },
    3: { basis: 'flex-[1_1_60%]', height: 'h-[320px] lg:h-[380px]' },
  };
  return configs[index] ?? { basis: 'flex-[1_1_100%]', height: 'h-[320px]' };
}

const bentoConfigs = displayMomentos.map((_, i) => getBentoConfig(i));

// Formatear fechas en el servidor para el atributo datetime y el texto visible
const formattedDates = displayMomentos.map(m => formatDateBySize(m.fecha, 'short'));
const allFormattedDates = sortedMomentos.map(m =>
  new Date(m.fecha).toLocaleDateString('es-PE', {
    year: 'numeric', month: 'long', day: 'numeric'
  })
);
---

{displayMomentos.length > 0 && (
  <section
    class="py-12 md:py-20 bg-[#fcfaec] relative overflow-hidden"
    aria-labelledby="highlighted-moments-title"
  >
    <div class="max-w-[1340px] mx-auto px-4 md:px-6 lg:px-8 relative z-10">

      <!-- Header de sección -->
      <div class="mb-8 md:mb-10">
        <div class="max-w-xl">
          <p class="text-xs font-label font-semibold uppercase tracking-[0.25em] text-[#2e0007]/50 mb-3">
            Nuestro Archivo
          </p>
          <h2
            id="highlighted-moments-title"
            class="text-2xl md:text-4xl font-headline font-bold text-[#2e0007] leading-tight"
          >
            Momentos Destacados
          </h2>
          <p class="text-[#564243] font-body mt-3 text-sm md:text-base leading-relaxed">
            Una ventana a los hitos y eventos que nos definen como círculo.
          </p>
        </div>
      </div>

      <!-- DESKTOP: Layout Bento Flex -->
      <div class="hidden md:flex flex-wrap gap-3 lg:gap-4">
        {displayMomentos.map((momento, index) => {
          const { basis: basisClass, height: heightClass } = bentoConfigs[index];
          const dateText = formattedDates[index];
          return (
            <article
              class={`momento-card open-gallery-btn moments-gallery-trigger group relative overflow-hidden rounded-2xl bg-stone-200 cursor-pointer ${basisClass} ${heightClass}`}
              data-index={index}
              role="button"
              tabindex="0"
              aria-label={`Ver momento del ${dateText}: ${momento.description}`}
            >
              <img
                src={`${momento.imagen.url}?w=900&fm=webp&q=82&fit=fill`}
                alt={momento.imagen.title || momento.description}
                class="absolute inset-0 w-full h-full object-cover transition-transform duration-700 ease-out group-hover:scale-[1.04]"
                loading={index < 2 ? 'eager' : 'lazy'}
                decoding="async"
              />

              <!-- Overlay sutil, se intensifica en hover -->
              <div class="moments-overlay absolute inset-0 bg-gradient-to-t from-black/75 via-black/10 to-transparent transition-opacity duration-500"></div>

              <!-- Contenido de tarjeta -->
              <div class="absolute inset-x-0 bottom-0 p-4 lg:p-5 pr-24">
                <div class="transform translate-y-1 group-hover:translate-y-0 transition-transform duration-400 ease-out">
                  <time
                    datetime={momento.fecha}
                    class="block font-serif italic text-[#ffdadb] text-base lg:text-lg leading-none mb-1"
                  >
                    {dateText}
                  </time>
                  <p class="text-white/90 font-body text-xs leading-snug opacity-0 group-hover:opacity-100 transition-opacity duration-400 line-clamp-2 mt-1">
                    {momento.description}
                  </p>
                </div>
              </div>

              <!-- Badge flotante circular (solo en la última imagen) -->
              {index === displayMomentos.length - 1 && hasMoreMomentos && (
                <div class="absolute bottom-4 right-4 lg:bottom-5 lg:right-5 z-20 flex flex-col items-center justify-center w-14 h-14 lg:w-16 lg:h-16 bg-white/95 backdrop-blur-md text-[#2e0007] rounded-full shadow-[0_8px_20px_rgba(0,0,0,0.15)] group-hover:scale-110 group-hover:bg-white transition-all duration-400 pointer-events-none">
                  <svg class="w-5 h-5 mb-0.5 opacity-80" fill="currentColor" viewBox="0 0 24 24">
                    <path d="M3 3h7v7H3V3zm11 0h7v7h-7V3zM3 14h7v7H3v-7zm11 0h7v7h-7v-7z"/>
                  </svg>
                  <span class="font-sans font-bold text-xs tracking-tight">+{totalMomentos - MAX_DISPLAY}</span>
                </div>
              )}
            </article>
          );
        })}
      </div>

      <!-- MOBILE: Layout Cuadrícula (Álbum) -->
      <div class="md:hidden">
        <div class="grid grid-cols-2 gap-2.5">
          {displayMomentos.map((momento, index) => {
            const dateText = formattedDates[index];
            const isLast = index === displayMomentos.length - 1 && hasMoreMomentos;
            
            return (
              <article
                class="momento-card open-gallery-btn moments-gallery-trigger relative aspect-square rounded-2xl overflow-hidden bg-stone-200 shadow-sm"
                data-index={index}
                role="button"
                tabindex="0"
                aria-label={isLast ? `Abrir galería con ${totalMomentos} fotos` : `Ver momento del ${dateText}`}
              >
                <img
                  src={`${momento.imagen.url}?w=400&h=400&fm=webp&q=80&fit=fill`}
                  alt={momento.imagen.title || momento.description}
                  class="absolute inset-0 w-full h-full object-cover"
                  loading={index < 2 ? 'eager' : 'lazy'}
                  decoding="async"
                />
                
                {/* Overlay oscuro y botón central (Solo en la última imagen) */}
                {isLast ? (
                  <div class="absolute inset-0 bg-black/50 backdrop-blur-[2px] flex flex-col items-center justify-center text-white z-10 pointer-events-none transition-colors active:bg-black/60">
                    <span class="font-sans font-bold text-3xl tracking-tight">+{totalMomentos - MAX_DISPLAY}</span>
                  </div>
                ) : (
                  <>
                    <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-transparent to-transparent"></div>
                    <div class="absolute inset-x-0 bottom-0 p-3 pointer-events-none">
                      <time datetime={momento.fecha} class="block font-serif italic text-[#ffdadb] text-sm leading-none mb-0.5">
                        {dateText}
                      </time>
                      <p class="text-white/85 font-body text-[10px] leading-tight line-clamp-2">
                        {momento.description}
                      </p>
                    </div>
                  </>
                )}
              </article>
            );
          })}
        </div>
      </div>

    </div>

    <!-- ============================================================
         MODAL GALERÍA
         Estructura: header fijo + cuerpo centrado + thumbnails fijos.
         Los botones de navegación están dentro del cuerpo (no del flex)
         para que nunca queden fuera del viewport.
    ============================================================ -->
    <div
      id="momentosGalleryModal"
      class="fixed inset-0 z-50 hidden"
      role="dialog"
      aria-modal="true"
      aria-labelledby="modalGalleryTitle"
      aria-hidden="true"
    >
      <!-- Fondo -->
      <div class="absolute inset-0 bg-black/96 backdrop-blur-md" id="modalBackdrop" aria-hidden="true"></div>

      <!-- Shell del modal: 3 filas fijas: header | cuerpo | thumbnails -->
      <div class="modal-shell relative z-10 w-full h-full flex flex-col">

        <!-- Fila 1: Header -->
        <header class="flex-none flex items-center justify-between px-4 py-3 md:px-6 md:py-4 border-b border-white/8">
          <div class="flex items-center gap-3">
            <span class="font-label text-xs text-white/40 uppercase tracking-widest" id="modalGalleryTitle">Galería</span>
            <span class="w-px h-3 bg-white/20"></span>
            <span class="font-label text-xs text-white/60" aria-live="polite">
              <span id="currentImageIndex" class="text-[#ffdadb]">1</span>
              <span class="text-white/30 mx-1">/</span>
              <span>{totalMomentos}</span>
            </span>
          </div>
          <button
            id="closeModalBtn"
            class="flex items-center justify-center w-9 h-9 rounded-full bg-white/6 hover:bg-white/12 border border-white/10 text-white/70 hover:text-white transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-white/50"
            aria-label="Cerrar galería"
          >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M6 18L18 6M6 6l12 12"/>
            </svg>
          </button>
        </header>

        <!-- Fila 2: Imagen principal + Botones de navegación (ocupa todo el espacio restante) -->
        <div class="modal-body flex-1 relative overflow-hidden">

          <!-- Botones de navegación: posicionados sobre la imagen, centrados verticalmente -->
          <button
            id="prevImageBtn"
            class="modal-nav-btn absolute left-2 md:left-4 top-1/2 -translate-y-1/2 z-20 flex items-center justify-center w-9 h-9 md:w-11 md:h-11 rounded-full bg-black/40 hover:bg-black/70 border border-white/15 text-white/70 hover:text-white transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-white/50"
            aria-label="Imagen anterior"
          >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
            </svg>
          </button>

          <button
            id="nextImageBtn"
            class="modal-nav-btn absolute right-2 md:right-4 top-1/2 -translate-y-1/2 z-20 flex items-center justify-center w-9 h-9 md:w-11 md:h-11 rounded-full bg-black/40 hover:bg-black/70 border border-white/15 text-white/70 hover:text-white transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-white/50"
            aria-label="Imagen siguiente"
          >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
            </svg>
          </button>

          <!-- Contenedor de imagen y caption -->
          <figure class="h-full flex flex-col items-center justify-center px-12 md:px-16 py-4 md:py-6">
            <!-- Área de imagen: flex-1 para ocupar espacio disponible, imagen contiene sin recortar -->
            <div class="flex-1 w-full flex items-center justify-center min-h-0 relative">
              <div id="imageLoader" class="absolute inset-0 flex items-center justify-center opacity-0 transition-opacity duration-200 pointer-events-none">
                <div class="w-6 h-6 border-2 border-[#ffdadb]/20 border-t-[#ffdadb]/80 rounded-full animate-spin"></div>
              </div>
              <img
                id="modalMainImage"
                src=""
                alt=""
                class="max-w-full max-h-full w-auto h-auto object-contain rounded-lg shadow-2xl opacity-0 transition-opacity duration-300"
              />
            </div>

            <!-- Caption: altura fija para no competir con la imagen -->
            <figcaption class="flex-none w-full max-w-2xl text-center pt-4 pb-1">
              <time id="modalImageDate" class="block font-serif italic text-[#ffdadb] text-base md:text-lg mb-1.5"></time>
              <p id="modalImageDescription" class="text-white/70 font-body text-xs md:text-sm leading-relaxed line-clamp-2"></p>
            </figcaption>
          </figure>
        </div>

        <!-- Fila 3: Tira de thumbnails -->
        <nav
          class="flex-none border-t border-white/8 bg-black/30 py-3 px-4 overflow-x-auto hide-scrollbar text-center"
          aria-label="Navegación de imágenes"
        >
          <div id="thumbnailsContainer" class="inline-flex gap-2 justify-center mx-auto text-left">
            {sortedMomentos.map((momento, index) => (
              <button
                class="thumbnail-btn relative flex-none w-12 h-12 md:w-14 md:h-14 rounded-lg overflow-hidden opacity-35 hover:opacity-80 transition-all duration-200 focus:outline-none focus-visible:ring-2 focus-visible:ring-[#ffdadb]"
                data-index={index}
                data-url={momento.imagen.url}
                data-description={momento.description}
                data-date={allFormattedDates[index]}
                aria-label={`Ir a imagen ${index + 1}`}
                aria-pressed="false"
              >
                <img
                  src={`${momento.imagen.url}?w=120&h=120&fit=fill&fm=webp&q=70`}
                  alt=""
                  class="w-full h-full object-cover"
                  loading="lazy"
                  decoding="async"
                />
                <div class="thumbnail-ring absolute inset-0 rounded-lg border-2 border-transparent transition-colors pointer-events-none"></div>
              </button>
            ))}
          </div>
        </nav>

      </div>
    </div>
  </section>
)}

<style>
  /* Ocultar scrollbar manteniendo funcionalidad */
  .hide-scrollbar {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }
  .hide-scrollbar::-webkit-scrollbar { display: none; }

  /* Animación de entrada escalonada para las tarjetas */
  .momento-card {
    animation: cardIn 0.6s cubic-bezier(0.22, 1, 0.36, 1) both;
  }
  .momento-card:nth-child(1) { animation-delay: 0.05s; }
  .momento-card:nth-child(2) { animation-delay: 0.12s; }
  .momento-card:nth-child(3) { animation-delay: 0.19s; }
  .momento-card:nth-child(4) { animation-delay: 0.26s; }

  @keyframes cardIn {
    from { opacity: 0; transform: translateY(16px) scale(0.98); }
    to   { opacity: 1; transform: translateY(0) scale(1); }
  }

  /* Estados del modal */
  #momentosGalleryModal.is-open {
    display: flex !important;
    animation: modalIn 0.25s ease-out;
  }
  @keyframes modalIn {
    from { opacity: 0; }
    to   { opacity: 1; }
  }

  /* El shell usa la altura completa del viewport, incluyendo notch en iOS */
  .modal-shell {
    height: 100dvh;
  }

  /* Thumbnails activos */
  .thumbnail-btn.active {
    opacity: 1;
  }
  .thumbnail-btn.active .thumbnail-ring {
    border-color: #ffdadb;
  }

  /* Soporte de reduced-motion */
  @media (prefers-reduced-motion: reduce) {
    .momento-card { animation: none; }
    #momentosGalleryModal.is-open { animation: none; }
    #modalMainImage { transition: none; }
  }
</style>

<script>
  /**
   * Controlador del modal de galería de momentos.
   * Compatible con Astro View Transitions (astro:page-load / astro:before-swap).
   */
  function initMomentsGallery() {
    const modal = document.getElementById('momentosGalleryModal') as HTMLElement;
    if (!modal) return;

    // Referencias a elementos del DOM
    const mainImage  = document.getElementById('modalMainImage') as HTMLImageElement;
    const loader     = document.getElementById('imageLoader');
    const dateEl     = document.getElementById('modalImageDate');
    const descEl     = document.getElementById('modalImageDescription');
    const indexEl    = document.getElementById('currentImageIndex');
    const closeBtn   = document.getElementById('closeModalBtn');
    const prevBtn    = document.getElementById('prevImageBtn');
    const nextBtn    = document.getElementById('nextImageBtn');
    const thumbnails = document.querySelectorAll<HTMLElement>('.thumbnail-btn');
    const triggers   = document.querySelectorAll<HTMLElement>('.moments-gallery-trigger');

    let currentIndex = 0;
    const total = thumbnails.length;

    // --- Funciones de control ---

    function setImage(index: number) {
      if (index < 0 || index >= total) return;
      const thumb = thumbnails[index];
      if (!thumb) return;

      currentIndex = index;

      // Actualizar metadatos visibles
      if (indexEl) indexEl.textContent = String(index + 1);
      if (descEl)  descEl.textContent  = thumb.dataset.description ?? '';
      if (dateEl)  dateEl.textContent  = thumb.dataset.date ?? '';

      // Carga de imagen con fade
      mainImage.style.opacity = '0';
      if (loader) loader.style.opacity = '1';

      const url = `${thumb.dataset.url}?w=1400&fm=webp&q=88`;
      const img = new Image();
      img.onload = () => {
        mainImage.src = url;
        mainImage.alt = thumb.dataset.description ?? '';
        requestAnimationFrame(() => {
          if (loader) loader.style.opacity = '0';
          mainImage.style.opacity = '1';
        });
      };
      img.onerror = () => {
        if (loader) loader.style.opacity = '0';
        mainImage.style.opacity = '1';
      };
      img.src = url;

      // Actualizar estado de thumbnails
      thumbnails.forEach((t, i) => {
        const active = i === index;
        t.classList.toggle('active', active);
        t.setAttribute('aria-pressed', String(active));
      });

      // Scroll suave al thumbnail activo
      thumb.scrollIntoView({ behavior: 'smooth', inline: 'center', block: 'nearest' });
    }

    function openModal(startIndex: number) {
      document.body.style.overflow = 'hidden';
      modal.classList.add('is-open');
      modal.setAttribute('aria-hidden', 'false');
      setImage(startIndex);
      // Foco accesible al cerrar
      closeBtn?.focus();
    }

    function closeModal() {
      document.body.style.overflow = '';
      modal.classList.remove('is-open');
      modal.setAttribute('aria-hidden', 'true');
      // Limpiar src para liberar memoria tras la animación de cierre
      setTimeout(() => { mainImage.src = ''; }, 300);
    }

    function prev() { setImage((currentIndex - 1 + total) % total); }
    function next() { setImage((currentIndex + 1) % total); }

    // --- Listeners ---

    // Disparadores del modal (tarjetas y botón "Ver galería")
    triggers.forEach(el => {
      el.addEventListener('click', () => {
        const idx = parseInt(el.dataset.index ?? '0', 10);
        openModal(isNaN(idx) ? 0 : idx);
      });
      // Accesibilidad de teclado para elementos con role="button"
      if (el.getAttribute('role') === 'button') {
        el.addEventListener('keydown', (e: Event) => {
          const ke = e as KeyboardEvent;
          if (ke.key === 'Enter' || ke.key === ' ') {
            ke.preventDefault();
            el.click();
          }
        });
      }
    });

    closeBtn?.addEventListener('click', closeModal);
    prevBtn?.addEventListener('click', prev);
    nextBtn?.addEventListener('click', next);

    thumbnails.forEach((btn, idx) => {
      btn.addEventListener('click', () => setImage(idx));
    });

    // Cerrar al hacer clic fuera de la imagen (en el backdrop)
    document.getElementById('modalBackdrop')?.addEventListener('click', closeModal);

    // Navegación por teclado
    function onKeydown(e: KeyboardEvent) {
      if (!modal.classList.contains('is-open')) return;
      if (e.key === 'Escape')     closeModal();
      if (e.key === 'ArrowLeft')  prev();
      if (e.key === 'ArrowRight') next();
    }
    document.addEventListener('keydown', onKeydown);

    // Cleanup al navegar con View Transitions (evita memory leaks)
    document.addEventListener('astro:before-swap', () => {
      document.removeEventListener('keydown', onKeydown);
      document.body.style.overflow = '';
    }, { once: true });
  }

  document.addEventListener('astro:page-load', initMomentsGallery);
</script>
