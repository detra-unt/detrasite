# =====================================================================
# .env.example — Detrasite
# Copiá este archivo como `.env` y completá los valores reales.
# Nunca subas el `.env` al repositorio (ya está en .gitignore).
# =====================================================================

# ── Contentful (CMS) ──────────────────────────────────────────────────
# Estas variables son privadas (server-side). Se usan en
# src/lib/contentful.ts para autenticar las queries GraphQL.

# ID del espacio de Contentful.
# Lo encontrás en: Contentful > Settings > API keys > Space ID
CONTENTFUL_SPACE_ID=xxxxxxxxxxxxx

# Token de la Content Delivery API (contenido publicado).
# Lo encontrás en: Contentful > Settings > API keys > Content Delivery API > Add API key
CONTENTFUL_DELIVERY_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Token de la Content Preview API (contenido en draft/no publicado).
# Lo encontrás en: Contentful > Settings > API keys > Content Preview API > Add API key
CONTENTFUL_PREVIEW_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── EmailJS (formulario de contacto) ──────────────────────────────────
# Estas variables son PÚBLICAS (el prefijo PUBLIC_ las expone al cliente).
# Se usan en src/components/react/ContactForm.tsx.

# Public Key de tu cuenta de EmailJS.
# La encontrás en: EmailJS Dashboard > Account > API Keys > Public Key
PUBLIC_EMAILJS_PUBLIC_KEY=xxxxxxxxxxxxxxx

# Service ID del servicio de email configurado (Gmail, Outlook, etc.).
# Lo encontrás en: EmailJS Dashboard > Email Services
PUBLIC_EMAILJS_SERVICE_ID=service_xxxxxxx

# Template ID de la plantilla de email usada en el formulario.
# Lo encontrás en: EmailJS Dashboard > Email Templates
PUBLIC_EMAILJS_TEMPLATE_ID=template_xxxxxxx
